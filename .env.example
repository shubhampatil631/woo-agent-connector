# WooCommerce API Configuration
WOO_STORE_URL=http://localhost:8080
WOO_CONSUMER_KEY=ck_test_dummy_key_replace_me
WOO_CONSUMER_SECRET=cs_test_dummy_secret_replace_me
WOO_AUTH_TYPE=api_key

# Privacy & Security Settings
# Options: redacted (default: masks email, phone, billing/shipping addresses) | full (unredacted)
WOO_PII_MODE=redacted
STRICT_READONLY=false

# Client & Agent Rate-Limiting Controls
WOO_RATE_LIMIT_RPS=5
WOO_MAX_PAGE_SIZE=50
WOO_REQUEST_TIMEOUT=15.0
WOO_MAX_RETRIES=3

# MCP HTTP Transport Security (Optional)
CONNECTOR_API_KEY=your_mcp_bearer_token_here
